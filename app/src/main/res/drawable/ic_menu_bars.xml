<!--
    The Menu button's icon: two switches, one outlined with its knob on the left and one filled
    with its knob on the right. Same drawing language as ic_menu_toggles, so either can be picked
    in the editor. Single colour, so the tile can tint it white or dark; the knob on the filled
    switch is a hole in the same path (evenOdd), not a second colour.

    Geometry as given, in a 48 unit box: outlined track 9..39 by 9..18 (r 4.5, 1 unit line), knob
    disc at 14,13.5 (r 4.5), filled track 8..40 by 25..36 (r 5.5) with its knob cut at 34,30.5.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Upper switch: outlined track. -->
    <path
        android:pathData="M13.5,9h21a4.5,4.5 0 0,1 0,9h-21a4.5,4.5 0 0,1 0,-9z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1" />

    <!-- Upper switch: knob, sitting on the left. -->
    <path
        android:pathData="M14,13.5m-4.5,0a4.5,4.5 0 1,0 9,0a4.5,4.5 0 1,0 -9,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Lower switch: filled track with the knob cut out on the right. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M13.5,25h21a5.5,5.5 0 0,1 0,11h-21a5.5,5.5 0 0,1 0,-11z M34,30.5m-4.5,0a4.5,4.5 0 1,0 9,0a4.5,4.5 0 1,0 -9,0"
        android:fillColor="#FFFFFFFF" />
</vector>
