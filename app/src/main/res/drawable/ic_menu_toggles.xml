<!--
    The Menu button's icon: two on/off switches, one off (outlined, knob left) and one on
    (filled, knob right). Single colour, so the tile can tint it white or dark; the knob on the
    filled switch is a hole in the same path (evenOdd), not a second colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Upper switch: outlined track. -->
    <path
        android:pathData="M6.4,4.6h11.2a3.4,3.4 0 0,1 0,6.8H6.4a3.4,3.4 0 0,1 0,-6.8z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.9"
        android:strokeLineJoin="round" />

    <!-- Upper switch: knob, sitting on the left. -->
    <path
        android:pathData="M6.7,8m-2.2,0a2.2,2.2 0 1,0 4.4,0a2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Lower switch: filled track with the knob cut out on the right. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M6.4,12.6h11.2a3.4,3.4 0 0,1 0,6.8H6.4a3.4,3.4 0 0,1 0,-6.8z M17.3,16m-2.2,0a2.2,2.2 0 1,0 4.4,0a2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="#FFFFFFFF" />
</vector>
